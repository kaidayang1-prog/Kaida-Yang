# 复制成 .env.local 再填写。这里只放占位，不要提交真实的 key。
# 本地 Supabase（supabase start 之后显示的地址和 anon key）
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Google 地图（前端显示地图用，在 Google Cloud 里限制域名）；留空则用模拟数据
NEXT_PUBLIC_GOOGLE_MAPS_BROWSER_KEY=
# 网页推送的公钥（M4 生成）
NEXT_PUBLIC_VAPID_PUBLIC_KEY=

# 下面这些只给 Supabase Edge Functions 用，放在 supabase/functions/.env，绝不能进前端：
# GOOGLE_MAPS_SERVER_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:admin@example.com
